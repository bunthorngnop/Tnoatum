# Copy this file to .env. Never commit .env.
SHOP_NAME=Tnoat Tum Cafe
SHOP_TIMEZONE=Asia/Phnom_Penh
OFFICIAL_OPEN_TIME=08:00
OFFICIAL_CLOSE_TIME=17:00
LATE_REMINDER_TIME=18:00

# Local SQLite runtime data is intentionally ignored by Git.
DATABASE_URL=sqlite:///data/tnoat_tum_cafe.sqlite3
LOG_LEVEL=INFO

# Comma-separated numeric Telegram IDs. No IDs are assumed.
OWNER_TELEGRAM_IDS=
TELEGRAM_BOT_TOKEN=
ENABLE_SAME_CURRENCY_SPLIT=true

# Phase 0 supports independent KHR and USD; no implicit conversion.
SUPPORTED_CURRENCIES=KHR,USD
REPORTING_EXCHANGE_RATE=

# Financial policies require owner configuration in later phases.
DISCOUNT_PRESETS=0
DISCOUNT_APPROVAL_THRESHOLD_PERCENT=
DISCREPANCY_TOLERANCE_KHR=
DISCREPANCY_TOLERANCE_USD=
BACKUP_RETENTION_DAYS=30
BACKUP_DIRECTORY=backups
