# Copy this file to .env. Never commit .env.
SHOP_NAME=Tnoat Tum Cafe
SHOP_TIMEZONE=Asia/Phnom_Penh
OFFICIAL_OPEN_TIME=08:00
OFFICIAL_CLOSE_TIME=17:00
LATE_REMINDER_TIME=18:00

# Local SQLite runtime data is intentionally ignored by Git.
DATABASE_URL=sqlite:///data/tnoat_tum_cafe.sqlite3
LOG_LEVEL=INFO

# Confirmed owner/admin numeric Telegram ID. Comma-separate additional approved owners.
OWNER_TELEGRAM_IDS=166792174
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TnoatTum_Cafe_bot
ENABLE_SAME_CURRENCY_SPLIT=true

# Phase 2 safest defaults: no expense auto-posting and receipts required.
# Limits are configured in the database with the owner-authorized CLI.
EXPENSE_WITHIN_LIMIT_POSTS_IMMEDIATELY=false
REQUIRE_RECEIPT_FOR_ALL_EXPENSES=true
EXPENSE_ATTACHMENT_DIRECTORY=receipts
MAX_EXPENSE_ATTACHMENT_BYTES=10000000

# Phase 0 supports independent KHR and USD; no implicit conversion.
SUPPORTED_CURRENCIES=KHR,USD
REPORTING_EXCHANGE_RATE=

# Financial policies require owner configuration in later phases.
DISCOUNT_PRESETS=0
DISCOUNT_APPROVAL_THRESHOLD_PERCENT=
DISCREPANCY_TOLERANCE_KHR=
DISCREPANCY_TOLERANCE_USD=
BACKUP_RETENTION_DAYS=30
BACKUP_DIRECTORY=backups
